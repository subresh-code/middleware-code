# Database (connect via Docker network - use container name)
DATABASE_URL=postgresql://postgres:postgres@db:5432/payments

# Rafiki / ILP Integration
RAFIKI_API_URL=
RAFIKI_AUTH_TOKEN=
RAFIKI_WEBHOOK_SECRET=
RAFIKI_ADMIN_URL=
RAFIKI_OPEN_PAYMENTS_URL=

# ISO 8583 Parser
ISO8583_HEADER_LENGTH=2

# TCP Server
TCP_HOST=0.0.0.0
TCP_PORT=9000
TCP_MAX_CONNECTIONS_PER_ASE=50
TCP_CONNECTION_TIMEOUT_SECONDS=30
TCP_MAX_MESSAGE_BYTES=4096

# Payment & Settlement
PAYMENT_TTL_SECONDS=300
