# Application
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL for production, SQLite for local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payments

# Rafiki / ILP Integration
RAFIKI_API_URL=http://localhost:3000
RAFIKI_AUTH_TOKEN=your_rafiki_token_here
RAFIKI_WEBHOOK_SECRET=your_webhook_secret_here

# ISO 8583 Parser
ISO8583_HEADER_LENGTH=2

# TCP Server
TCP_HOST=0.0.0.0
TCP_PORT=9000
TCP_MAX_CONNECTIONS_PER_ASE=50
TCP_CONNECTION_TIMEOUT_SECONDS=30
TCP_MAX_MESSAGE_BYTES=4096

# Payment & Settlement
PAYMENT_TTL_SECONDS=300

# Job Queue
REDIS_URL=redis://localhost:6379/0
